/* rofi: Rosé Pine, styled like the login and lock screens. */

configuration {
    modi:                "drun,run,window";
    show-icons:          true;
    drun-display-format: "{name}";
    display-drun:        "Apps";
    display-run:         "Run";
    display-window:      "Windows";
}

* {
    base:          #191724;
    surface:       #1f1d2e;
    overlay:       #26233a;
    muted:         #6e6a86;
    subtle:        #908caa;
    fg:            #e0def4;
    love:          #eb6f92;
    rose:          #ebbcba;
    iris:          #c4a7e7;
    highlight-med: #403d52;
    gold:          #f6c177;
    foam:          #9ccfd8;

    /* Colors of the "Apps" prompt, the text you type and the app list */
    prompt-color: @fg;
    entry-color:  @iris;
    list-color:   @fg;

    font:             "Red Hat Display 12";
    background-color: transparent;
    text-color:       @fg;
    margin:           0;
    padding:          0;
    spacing:          0;
}

window {
    width:            600px;
    border-radius:    16px;
    border:           2px solid;
    border-color:     @iris;
    background-color: @base;
}

mainbox {
    children: [ inputbar, listview ];
    padding:  16px;
    spacing:  12px;
}

/* Search field, like the password field on the lock screen */
inputbar {
    children:         [ prompt, entry ];
    background-color: @overlay;
    border-radius:    12px;
    padding:          10px 14px;
    spacing:          10px;
}

prompt {
    text-color: @prompt-color;
    font:       "Red Hat Display Bold 12";
}

entry {
    expand:            true;
    text-color:        @entry-color;
    placeholder:       "Search";
    placeholder-color: @subtle;
}

listview {
    lines:        4;
    columns:      1;
    fixed-height: true;
    scrollbar:    false;
    spacing:      4px;
    border:       0px;
}

element {
    padding:       8px 12px;
    spacing:       12px;
    border-radius: 10px;
    cursor:        pointer;
}

element-icon {
    size:   24px;
    cursor: inherit;
}

element-text {
    vertical-align:   0.5;
    highlight:        bold #ebbcba;
    cursor:           inherit;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color:       @list-color;
}

element selected.normal {
    background-color: @highlight-med;
    text-color:       @list-color;
}

element normal.urgent,
element alternate.urgent,
element selected.urgent {
    text-color: @love;
}

element normal.active,
element alternate.active,
element selected.active {
    text-color: @iris;
}

element-icon, element-text {
    background-color: transparent;
    text-color:       inherit;
}

message {
    background-color: @overlay;
    border-radius:    12px;
    padding:          10px 14px;
}

textbox {
    text-color: @fg;
}
